{
  "expo": {
    "name": "STACKORA",
    "slug": "stackora",
    "version": "0.1.0",
    "scheme": "stackora",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stackora.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "STACKORA se connecte à votre serveur de poker de test sur le réseau local.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#102C27"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png",
      "name": "STACKORA",
      "shortName": "STACKORA"
    }
  }
}
